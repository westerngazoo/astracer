{
  "name": "livewalk",
  "displayName": "Livewalk (Live Code Walk)",
  "description": "Call graph, Code and Flow views for your workspace, with jump-to-source, caller CodeLens and flow-to-here, powered by the lcw CLI.",
  "version": "0.2.0",
  "publisher": "livewalk",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/westerngazoo/astracer"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "workspaceContains:Cargo.toml",
    "workspaceContains:livewalk.toml",
    "onLanguage:rust"
  ],
  "contributes": {
    "commands": [
      {
        "command": "livewalk.openGraph",
        "title": "Open Graph",
        "category": "Livewalk"
      },
      {
        "command": "livewalk.openGraphHere",
        "title": "Open Graph Here",
        "category": "Livewalk"
      },
      {
        "command": "livewalk.openGraphHereExplorer",
        "title": "Open Graph Here",
        "category": "Livewalk"
      },
      {
        "command": "livewalk.revealInGraph",
        "title": "Reveal in Graph",
        "category": "Livewalk"
      },
      {
        "command": "livewalk.showFlowToHere",
        "title": "Show Flow to Here",
        "category": "Livewalk"
      },
      {
        "command": "livewalk.showCallersHere",
        "title": "Show Callers of Function at Cursor",
        "category": "Livewalk"
      },
      {
        "command": "livewalk.toggleCodeLens",
        "title": "Toggle Caller CodeLens",
        "category": "Livewalk"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "livewalk.openGraphHere",
          "when": "resourceScheme == file",
          "group": "navigation@89"
        },
        {
          "command": "livewalk.revealInGraph",
          "when": "resourceScheme == file",
          "group": "navigation@89"
        },
        {
          "command": "livewalk.showFlowToHere",
          "when": "editorLangId == rust",
          "group": "navigation@90"
        }
      ],
      "explorer/context": [
        {
          "command": "livewalk.openGraphHereExplorer",
          "when": "resourceScheme == file",
          "group": "navigation@90"
        }
      ],
      "editor/title/context": [
        {
          "command": "livewalk.openGraphHere",
          "when": "resourceScheme == file",
          "group": "navigation@90"
        }
      ],
      "commandPalette": [
        {
          "command": "livewalk.openGraphHereExplorer",
          "when": "false"
        },
        {
          "command": "livewalk.revealInGraph",
          "when": "editorIsOpen"
        },
        {
          "command": "livewalk.showFlowToHere",
          "when": "editorIsOpen"
        },
        {
          "command": "livewalk.showCallersHere",
          "when": "editorIsOpen"
        }
      ]
    },
    "configuration": {
      "title": "Livewalk",
      "properties": {
        "livewalk.lcwPath": {
          "type": "string",
          "default": "lcw",
          "markdownDescription": "Path to the `lcw` binary. The default `lcw` is looked up on `PATH`, then in `~/.cargo/bin`. Example: `/Users/me/projects/livewalk/target/release/lcw`."
        },
        "livewalk.confirmBeforeLoad": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Ask before **Open Graph Here** loads a project (shows the resolved project root, and whether a fresh cached graph makes it instant)."
        },
        "livewalk.followCursor": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Keep the open graph panel's selection on the function under the editor cursor (debounced)."
        },
        "livewalk.codeLens": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show `N callers · impact` above each function (one `lcw symbols` call per file, served from the cached graph)."
        },
        "livewalk.codeLensLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "rust"
          ],
          "description": "Language ids that get caller CodeLens."
        },
        "livewalk.impactDepth": {
          "type": "number",
          "default": 3,
          "description": "Caller hops followed by the impact lens."
        },
        "livewalk.ollamaModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "Ollama model for **Explain** (empty: `$OLLAMA_MODEL`, else `qwen2.5-coder:7b`). Gemini reads `$GEMINI_API_KEY` from the editor's environment."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -w -p .",
    "media": "node scripts/copy-media.js",
    "test": "npm run build && node --test out/test/protocol.test.js out/test/webviewHtml.test.js out/test/roots.test.js",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.85.0",
    "typescript": "^5.4.0"
  }
}
