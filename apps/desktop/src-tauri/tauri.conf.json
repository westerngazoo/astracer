{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Live Code Walk",
  "version": "0.1.0",
  "identifier": "com.livewalk.desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "script": "trunk serve",
      "cwd": "../frontend"
    },
    "beforeBuildCommand": {
      "script": "trunk build",
      "cwd": "../frontend"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Live Code Walk & Analysis",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
